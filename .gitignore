# 密钥与敏感配置（绝对不要提交）
.env
data/master.key
data/*.key
data/api_token.txt

# 数据库
data/*.db
data/*.db-*

# 日志
data/logs/
data/*.log
data/svc_*.log

# 数据库备份（P0-1：备份目录整体不入库，防仓库随备份增长）
data/backups/

# 运行时产物
data/models/
data/*.png
data/shots/
data/*.csv
data/*.json
data/backtest_*.json

# 开发调试脚本（data/ 下的 check_/test_/shot_/diag_/e2e_ 脚本按需清理后提交）
data/check_*.py
data/test_*.py
data/shot_*.py
data/diag_*.py
data/e2e_*.py
data/probe*.py
data/gpu_test.py
data/geckodriver/
data/geckodriver.zip
data/dom_*.txt

# 本地调试脚本（一次性探测/截图，不对外发布）
scripts/dev/
tests/check_*.py
tests/e2e_*.py

# 并行开发 worktree 残留（data/_wt* 为完整项目副本，误提交会造成体积污染）
data/_wt*/
.worktrees/

# 测试报告产物
reports/

# DSH 记忆技能仓库（独立 git 仓库，不随项目提交）
.dsh-memory-setup/
dsh-memory-setup/

# 备份文件
*.bak

# 清理归档区（2026-09-13 从工作区移出的缓存/残留/一次性脚本；人工核对后再删）
_trash_archive/

# 自治优化协议工作产物（state/result/log/知识库/探针/备份，不随项目提交；
# 如需归档可分拣后手工提交）
.optim/

# 根目录调试/运行时产物（一次性探测脚本、pytest JUnit 报告、服务日志）
/probe*.py
/_probe*.py
/_inspect*.py
/_guard_test.py
/_restore_test.py
/_*.xml
/_patch_bt_group.py
/patch_bt_group.py
/server*.log
/server*.err.log
/try
/'

# 本地智能体工作目录（会话记忆/临时截图/日志，属本机运行态，不进版本库）
.workbuddy/
.zcode/

# IDE
.idea/
.vscode/
*.swp

# DSH 注入/路由套件（本机工具产物，不进项目库）
/vendor/

# SDD 工作区（临时产物，不进版本库）
.superpowers/


# 一次性提交信息/临时产物
.improve/

# 覆盖率数据与运行时快照（提交时保持仓库干净）
.coverage
data/*.pkl

# 前端备份/临时文件（index.html.bak_* 是编辑历史备份，不入库）
web/static/index.html.bak_*

# 意外创建/临时脚本
/\{fontSize
/verify-*.mjs

# 网络加速客户端二进制与临时配置（bin/ 是「一键下载 hysteria」的运行时落盘目录：
# hysteria-windows-amd64.exe 约 23MB，另有 hy2_client_*.json。属运行态产物，永不入库；
# 该目录此前未被忽略，`git add -A` 会静默吞下 23MB 二进制）
/bin/

# DSH harness 自检注入器在项目根误建的 junction 循环目录（路径名由 harness 拼接错误产生，
# 内部 node_modules 是指向自身的长路径 junction；会让 git status / grep 报
# "could not open directory ... Invalid argument"。本机工具产物，永不入库）
/Userssbxg*self*test*/
