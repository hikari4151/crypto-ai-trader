# ===================== 主密钥（用于加密存储 API Key） =====================
# 留空则首次启动自动生成到 data/master.key（权限 600）
# 建议自行设置：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MASTER_KEY=

# ===================== 数据库 =====================
# SQLite（默认，零配置）
DATABASE_URL=sqlite+aiosqlite:///./data/trader.db
# PostgreSQL（可选）
# DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/crypto_trader

# ===================== 交易所密钥（也可在 Web 界面配置，二选一） =====================
EXCHANGE_BINANCE_API_KEY=
EXCHANGE_BINANCE_SECRET=
EXCHANGE_BINANCE_PASSWORD=
EXCHANGE_OKX_API_KEY=
EXCHANGE_OKX_SECRET=
EXCHANGE_OKX_PASSWORD=
EXCHANGE_BYBIT_API_KEY=
EXCHANGE_BYBIT_SECRET=
EXCHANGE_BYBIT_PASSWORD=
EXCHANGE_BITGET_API_KEY=
EXCHANGE_BITGET_SECRET=
EXCHANGE_BITGET_PASSWORD=

# ===================== 网络代理（解决 OKX/Bitget/Bybit 等受限交易所连接问题） =====================
# 留空则自动探测本机常见 Clash / V2Ray 代理端口（7890/1080 等）
# 也可显式指定，如：PROXY_URL=http://127.0.0.1:7890
PROXY_URL=

# ===================== AI（也可在 Web 界面配置，二选一） =====================
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1        # DeepSeek: https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini                          # DeepSeek: deepseek-chat
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_MAX_RETRIES=3
AI_RATE_LIMIT_RPM=30                          # 每分钟最大请求数
AI_RATE_LIMIT_MIN_INTERVAL=2.0                # 两次请求最小间隔（秒）

# ===================== 运行模式 =====================
# true=纸面模拟（无需交易所Key即可体验全流程）；false=实盘
PAPER_TRADING=true
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# ===================== Web 服务 =====================
# 默认仅本机访问；需要局域网访问时改为 0.0.0.0（注意：此时局域网内设备可访问 API）
WEB_HOST=127.0.0.1
WEB_PORT=8000
# API 访问令牌：所有 /api/* 请求需携带 X-API-Token 头（前端自动携带）。
# 留空则每次启动自动生成并打印到日志。建议固定配置一个随机值。
# 生成示例：python -c "import secrets; print(secrets.token_hex(16))"
API_TOKEN=